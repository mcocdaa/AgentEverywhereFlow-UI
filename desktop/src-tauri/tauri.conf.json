{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AEFlow Desktop",
  "version": "0.2.1-rc.1",
  "identifier": "io.agenteverywhereflow.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "command",
        "title": "AEFlow",
        "url": "index.html?view=command",
        "width": 688,
        "height": 172,
        "minWidth": 568,
        "minHeight": 156,
        "maxWidth": 728,
        "maxHeight": 620,
        "center": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": true,
        "shadow": false,
        "skipTaskbar": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
